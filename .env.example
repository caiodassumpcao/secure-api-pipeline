# Copy to .env (git-ignored). Read by `pnpm dev` / `pnpm start` and by Docker Compose.
# Values here are for local development only.

# --- API -------------------------------------------------------------------
# development | test | production (production enforces strict checks)
NODE_ENV=development
# Interface to bind. The container image sets 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Serve Swagger UI at /docs and the document at /openapi.json (true | false).
# Defaults to true, except with NODE_ENV=production.
# API_DOCS_ENABLED=true

# --- Authentication ----------------------------------------------------------
# Ed25519 key pair that signs access tokens. `pnpm keys:generate` writes a
# development pair to keys/ (git-ignored); production keys are secrets managed
# by the operator. The API refuses to start without them.
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
# Public key of the previous pair, still accepted while rotating keys.
# JWT_PREVIOUS_PUBLIC_KEY_FILE=keys/jwt-previous-public.pem
# Token issuer and audience (both default to secure-api-pipeline).
# JWT_ISSUER=secure-api-pipeline
# JWT_AUDIENCE=secure-api-pipeline

# --- Telemetry (OpenTelemetry) ---------------------------------------------------
# OTLP/HTTP collector. With `pnpm dev` and the observability profile running:
# http://localhost:4318. Unset: nothing is pushed.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Share of traces kept. The code defaults to 0.1, safe for production traffic;
# development keeps every trace.
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_SERVICE_NAME=secure-api
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=secure-api-pipeline
# Disables traces, metrics and log export altogether.
# OTEL_SDK_DISABLED=false
# How often metrics are pushed over OTLP, in milliseconds.
# OTEL_METRIC_EXPORT_INTERVAL=60000
# Internal Prometheus endpoint (/metrics): never published, never behind the
# proxy. The container image binds it to 0.0.0.0, inside the Docker network.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464

# --- HTTP --------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated (https only in
# production). Unset: no cross-origin access.
# CORS_ORIGINS=http://localhost:5173
# Reverse proxies whose X-Forwarded-For is trusted: a hop count (1-10) or a
# comma-separated list of IPs/CIDRs. Off by default; enable it only behind a
# proxy, or clients could choose their own IP.
# TRUST_PROXY=1

# PostgreSQL connection URL (percent-encode special characters in the password).
# Points at the Compose database published on localhost. Inside Compose the API
# gets its own URL with the `postgres` service as host.
DATABASE_URL=postgres://app:postgres@localhost:5432/app
# Alternatively, read the URL from a file (Docker secrets). Do not set both.
# DATABASE_URL_FILE=/run/secrets/database_url

# --- Docker Compose ----------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Host ports, bound to 127.0.0.1 only.
API_PORT=3000
POSTGRES_PORT=5432
