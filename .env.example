# Copy to .env (git-ignored). Read by `pnpm dev` / `pnpm start` and by Docker Compose.
# Values here are for local development only.

# --- API -------------------------------------------------------------------
# development | test | production (production enforces strict checks)
NODE_ENV=development
# Interface to bind. The container image sets 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection URL (percent-encode special characters in the password).
# Points at the Compose database published on localhost. Inside Compose the API
# gets its own URL with the `postgres` service as host.
DATABASE_URL=postgres://app:postgres@localhost:5432/app
# Alternatively, read the URL from a file (Docker secrets). Do not set both.
# DATABASE_URL_FILE=/run/secrets/database_url

# --- Docker Compose ----------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Host ports, bound to 127.0.0.1 only.
API_PORT=3000
POSTGRES_PORT=5432
